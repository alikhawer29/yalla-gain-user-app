def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Required by @react-native-firebase/* when linking Firebase as CocoaPods frameworks
$RNFirebaseAsStaticFramework = true

setup_permissions([
  'Camera',
  'Microphone',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

pod 'AppAuth', '~> 1.0'

target 'YallaGain' do
  config = use_native_modules!

  # Firebase (Swift) + static frameworks: GoogleUtilities must expose a module map
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26.4 + fmt 11.0.2: Apple Clang rejects FMT_STRING consteval in format-inl.h.
    # Compile only the fmt pod as C++17 so FMT_USE_CONSTEVAL stays disabled.
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |build_config|
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
    
    # Exclude react-native-unity's RNUnityView and RNUnityViewManager files since we're using our own implementations
    installer.pods_project.targets.each do |target|
      if target.name == 'react-native-unity'
        files_to_remove = []
        target.source_build_phase.files.each do |file|
          file_ref_path = file.file_ref.path.to_s rescue ''
          file_ref_name = file.file_ref.name.to_s rescue ''
          # Remove all RNUnityView and RNUnityViewManager implementation files from the package
          if file_ref_name.include?('RNUnityView.mm') || 
             file_ref_name.include?('RNUnityViewManager.mm') ||
             file_ref_path.include?('RNUnityView.mm') ||
             file_ref_path.include?('RNUnityViewManager.mm')
            files_to_remove << file
          end
        end
        files_to_remove.each do |file|
          file.remove_from_project
          puts "Removed duplicate Unity file: #{file.file_ref.name rescue 'unknown'}"
        end
      end
    end
    
    # Exclude UnityFramework from simulator builds (it's only built for device/arm64)
    # Modify xcconfig files to exclude UnityFramework for simulator
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*.xcconfig')).each do |xcconfig_path|
      xcconfig = File.read(xcconfig_path)
      if xcconfig.include?('-framework "UnityFramework"')
        # Add simulator-specific exclusion: remove UnityFramework for simulator builds
        xcconfig_mod = xcconfig.dup
        other_ldflags_match = xcconfig_mod.match(/^(OTHER_LDFLAGS\s*=\s*)(.+)$/)
        if other_ldflags_match
          flags = other_ldflags_match[2]
          # Create simulator-specific flags without UnityFramework
          simulator_flags = flags.gsub(/-framework "UnityFramework"/, '')
          xcconfig_mod += "\nOTHER_LDFLAGS[sdk=iphonesimulator*] = #{simulator_flags.strip}\n"
          File.write(xcconfig_path, xcconfig_mod)
        end
      end
    end
    
    # Modify frameworks install script to skip UnityFramework for simulator
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*-frameworks.sh')).each do |script_path|
      script = File.read(script_path)
      if script.include?('install_framework') && script.include?('UnityFramework')
        # Wrap UnityFramework install in a condition to skip for simulator
        script.gsub!(/(.*install_framework\s+"[^"]*UnityFramework\.framework".*)/) do |match|
          "if [ \"${PLATFORM_NAME}\" != \"iphonesimulator\" ]; then\n  #{match}\nfi"
        end
        File.write(script_path, script)
      end
    end
  end
end
