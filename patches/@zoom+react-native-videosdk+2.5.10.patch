rrent\n *   values whereas the corresponding object data isHost, isManager, userName contains\n *   the initial value when it's retrieved and never gets updated.\n *\n *    const mySelf: ZoomVideoSdkUser = new ZoommVideoSdkUser(await zoom.session.getMySelf());\n *    const isManager = await mySelf.getIsManager();\n *\n */\n\n/**\n * Zoom Video SDK user information.\n */\nexport type ZoomVideoSdkUserType = {\n  /**\n   * The userId of the user object.\n   */\n  userId: string;\n\n  /**\n   * User's custom identity that is passed in the JWT or in SDKSessionContext.customUserId\n   */\n  customUserId: string;\n\n  /**\n   * User name.\n   */\n  userName: string;\n\n  /**\n   * Determine whether the user is the host.\n   */\n  isHost: boolean;\n\n  /**\n   * Determine whether the user is the manager.\n   */\n  isManager: boolean;\n\n  /**\n   * Whether the user is a broadcast streaming viewer joined via\n   * BroadcastStreamingViewer (i.e. outside the session). Their userName\n   * comes from StreamingJoinContext.userName and may be empty if not\n   * provided on join.\n   */\n  isIncomingLiveStreamUser?: boolean;\n\n  /**\n   * Determine whether the user is in failover (reconnecting to the session\n   * after a network interruption).\n   */\n  isInFailover?: boolean;\n\n  /**\n   * Determine whether the user has multiple cameras.\n   */\n  hasMultiCamera: boolean;\n\n  /**\n   * The index of the user's multi-camera stream.\n   */\n  multiCameraIndex: string;\n\n  /**\n   * Determine whether the user is the host.\n   */\n  getIsHost: () => Promise<boolean>;\n\n  /**\n   * Determine whether the user is the manager.\n   */\n  getIsManager: () => Promise<boolean>;\n\n  /**\n   * Determine whether the user is a broadcast streaming viewer.\n   */\n  getIsIncomingLiveStreamUser: () => Promise<boolean>;\n\n  /**\n   * Determine whether the user is in failover.\n   */\n  getIsInFailover: () => Promise<boolean>;\n\n  /**\n   * Get the name of the user in the session.\n   */\n  g