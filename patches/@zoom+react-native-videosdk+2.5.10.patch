-        subscribeIfNeeded();
-    }
-
-    @Override
-    protected void onDetachedFromWindow() {
-        super.onDetachedFromWindow();
-        unsubscribeIfNeeded();
-    }
-
-    private void subscribeIfNeeded() {
-        if (subscribed) {
-            return;
-        }
-        ZoomVideoSDKBroadcastStreamingViewer viewer = getViewer();
