+{
+    dispatch_async(dispatch_get_main_queue(), ^{
+        MobileRTCMeetingService *meetService = [[MobileRTC sharedRTC] getMeetingService];
+        if (meetService) {
+            MobileRTCMeetingState state = [meetService getMeetingState];
+            resolve(@(state));
+        } else {
+            resolve(@(0)); // MobileRTCMeetingState_Idle
+        }
+    });
+}
